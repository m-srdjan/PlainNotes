%YAML 1.2
---
# Fenced code blocks for PlainNotes. Generated by scripts/gen_fenced.py -- edit that, not this.
#
# Languages are pulled in with `embed` + `escape` rather than `include`, so the
# closing fence always ends the block no matter what state the embedded syntax
# is in (an unclosed `{`, string, template literal, ...).
name: "-"
scope: text.html.markdown.note.fenced
hidden: true

variables:
  # 1: indentation, 2: fence, 3: language, 4: rest of the info string
  fence_open: '(?:^|\G)([ \t]*)([`~]{3,})[ \t]*'
  fence_info: '(?=[ \t{]|$)[ \t]*([^\n]*?)[ \t]*$\n?'
  fence_close: '^[ \t]*(\2)[ \t]*$\n?'

contexts:
  main:
    - include: fenced-code-blocks

  fenced-code-blocks:
    - include: fenced-bat
    - include: fenced-c
    - include: fenced-c++
    - include: fenced-clojure
    - include: fenced-coffee
    - include: fenced-csharp
    - include: fenced-css
    - include: fenced-diff
    - include: fenced-erlang
    - include: fenced-go
    - include: fenced-haskell
    - include: fenced-html
    - include: fenced-java
    - include: fenced-js
    - include: fenced-json
    - include: fenced-jsx
    - include: fenced-latex
    - include: fenced-less
    - include: fenced-lisp
    - include: fenced-lua
    - include: fenced-makefile
    - include: fenced-markdown
    - include: fenced-matlab
    - include: fenced-obj-c
    - include: fenced-perl
    - include: fenced-php
    - include: fenced-powershell
    - include: fenced-python
    - include: fenced-r
    - include: fenced-regexp
    - include: fenced-ruby
    - include: fenced-rust
    - include: fenced-sass
    - include: fenced-scala
    - include: fenced-scss
    - include: fenced-shell
    - include: fenced-sql
    - include: fenced-tex
    - include: fenced-toml
    - include: fenced-ts
    - include: fenced-tsx
    - include: fenced-xml
    - include: fenced-yaml
    - include: fenced-zsh
    - include: fenced-undefined

  fenced-bat:
    - match: '{{fence_open}}((?i:bat|batch|cmd|dosbatch)){{fence_info}}'
      captures:
        0: markup.raw.block.markdown markup.raw.block.fenced.markdown
        2: punctuation.definition.raw.block.fenced.markdown
        3: meta.definition.language.raw.block.fenced.markdown
        4: meta.definition.language.raw.block.fenced.markdown
      embed: scope:source.dosbatch
      embed_scope: markup.raw.block.markdown markup.raw.block.fenced.markdown meta.language.dosbatch
      escape: '{{fence_close}}'
      escape_captures:
        0: markup.raw.block.markdown markup.raw.block.fenced.markdown
        1: punctuation.definition.raw.block.fenced.markdown

  fenced-c:
